@charset "utf-8";

#btn-allergeni-popup { background-color: transparent; color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; font-size: 16px; border-radius: 0px; cursor: pointer; font-weight: 600; transition: 0.3s; box-shadow: none; width: 100%; display: block; box-sizing: border-box; }

#btn-allergeni-popup:hover { opacity: 0.9; transform: none; box-shadow: none; }

.allergeni-modal-backdrop { display: none; position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.85); animation: 0.3s ease 0s 1 normal none running allergeni-fadeIn; z-index: 2147483647 !important; }

.allergeni-modal-backdrop.active { display: flex; justify-content: center; align-items: center; }

.allergeni-modal-content { background: rgb(20, 20, 20); color: rgb(255, 255, 255); border-radius: 16px; padding: 0px; max-width: 420px; width: 92%; box-shadow: rgba(0, 0, 0, 0.8) 0px 20px 60px; animation: 0.3s ease 0s 1 normal none running allergeni-slideUp; overflow: hidden; display: flex; flex-direction: column; }

.allergeni-modal-header { background: rgb(28, 28, 30); color: white; padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgb(44, 44, 46); }

.allergeni-modal-header h2 { font-size: 15px; margin: 0px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(255, 255, 255); }

.allergeni-modal-close { background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(142, 142, 147); font-size: 26px; cursor: pointer; padding: 0px; width: 32px; height: 32px; display: flex; justify-content: center; align-items: center; }

.allergeni-modal-body { padding: 15px 0px; max-height: 75vh; overflow-y: auto; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }

.drum-stage-3d { position: relative; width: 100%; height: 260px; display: flex; justify-content: center; align-items: center; perspective: 1000px; overflow: hidden; margin-bottom: 5px; }

.drum-cylinder-track { position: relative; width: 150px; height: 225px; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }

.drum-card { position: absolute; top: 0px; left: 0px; width: 150px; height: 225px; border-radius: 10px; overflow: hidden; background: rgb(44, 44, 46); box-shadow: rgba(0, 0, 0, 0.6) 0px 8px 25px; backface-visibility: hidden; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.6s, border 0.3s; border: 1px solid rgb(58, 58, 60); }

.drum-card img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }

.drum-side-trigger { position: absolute; top: 0px; width: 25%; height: 90%; z-index: 9999; cursor: pointer; display: flex; align-items: center; color: rgba(255, 255, 255, 0.5); font-size: 22px; text-shadow: rgba(0, 0, 0, 0.8) 0px 2px 4px; user-select: none; }

.drum-trigger-left { left: 0px; justify-content: flex-start; padding-left: 15px; }

.drum-trigger-right { right: 0px; justify-content: flex-end; padding-right: 15px; }

.allergeni-info-box { width: 88%; background: rgb(28, 28, 30); border-radius: 12px; padding: 14px; box-sizing: border-box; text-align: center; min-height: 100px; border: 1px solid rgb(44, 44, 46); margin-top: 5px; z-index: 10; }

.allergeni-info-title { font-weight: 700; font-size: 15px; color: rgb(255, 149, 0); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }

.allergeni-info-text { font-size: 13px; color: rgb(209, 209, 214); line-height: 1.4; }

.drum-dots { display: flex; justify-content: center; gap: 5px; margin: 8px 0px; flex-wrap: wrap; width: 85%; z-index: 10; }

.drum-dot { width: 6px; height: 6px; background: rgb(58, 58, 60); border-radius: 50%; transition: background 0.3s, transform 0.3s; }

.drum-dot.active { background: rgb(255, 149, 0); transform: scale(1.2); }

.allergeni-modal-footer { padding: 12px 20px; background-color: rgb(28, 28, 30); border-top: 1px solid rgb(44, 44, 46); display: flex; }

.allergeni-btn-close-modal { flex: 1 1 0%; padding: 11px 16px; background: linear-gradient(135deg, rgb(255, 149, 0) 0%, rgb(255, 94, 58) 100%); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; }

@keyframes allergeni-fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes allergeni-slideUp { 
  0% { transform: translateY(15px); opacity: 0; }
  100% { transform: translateY(0px); opacity: 1; }
}