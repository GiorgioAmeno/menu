@charset "utf-8";

.isy-cookie-bar, .isy-cookie-bar * { box-sizing: border-box; }

.isy-cookie-bar { position: fixed; top: 0px; left: 0px; right: 0px; z-index: 2147483646; background: rgb(20, 20, 20); color: rgb(242, 242, 242); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; font-size: 11px; line-height: 1.3; padding: 4px 9px; border-bottom: 1px solid rgb(44, 44, 46); display: none; }

.isy-cookie-bar.isy-cookie-show { display: block; }

.isy-cookie-row { max-width: 1100px; margin: 0px auto; display: flex; align-items: center; flex-wrap: nowrap; gap: 6px; justify-content: space-between; }

.isy-cookie-msg { flex: 1 1 auto; text-align: left; }

.isy-cookie-msg a { color: rgb(255, 149, 0); text-decoration: underline; }

.isy-cookie-btn { font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 11px; font-weight: 600; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; border-radius: 5px; padding: 4px 9px; white-space: nowrap; background: rgb(255, 149, 0); color: rgb(20, 20, 20); flex: 0 0 auto; transition: opacity 0.15s; }

.isy-cookie-btn:hover { opacity: 0.88; }

@media (max-width: 600px) {
  .isy-cookie-bar { font-size: 11px; padding: 4px 9px; }
}