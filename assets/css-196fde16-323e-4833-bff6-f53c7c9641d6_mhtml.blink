@keyframes reveal-tricolor-pizza { 
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.04); opacity: 0; }
}

#install-container-pizza .pwa-install-btn { display: none; position: relative !important; width: 100% !important; padding: 2px !important; border-radius: 50px !important; background: transparent !important; overflow: hidden !important; cursor: pointer !important; z-index: 0 !important; }

#install-container-pizza .pwa-install-btn::before { content: "" !important; position: absolute !important; inset: 0px !important; border-radius: 50px !important; background: linear-gradient(90deg, rgb(31, 170, 97) 0%, rgb(255, 255, 255) 50%, rgb(255, 0, 0) 100%) !important; z-index: 1 !important; animation: 4s ease-in-out 0s infinite normal none running reveal-tricolor-pizza !important; }

#install-container-pizza .btn-inner { position: relative !important; z-index: 2 !important; background: rgb(26, 26, 26) !important; border-radius: 48px !important; padding: 5px 15px !important; display: flex !important; align-items: center !important; justify-content: center !important; gap: 10px !important; min-height: 40px !important; }

#install-container-pizza .btn-text { color: rgb(255, 255, 255) !important; font-family: sans-serif !important; font-size: 14px !important; font-weight: bold !important; }

#install-container-pizza .icon-circle { width: 24px !important; height: 24px !important; min-width: 24px !important; max-width: 24px !important; border-radius: 50% !important; overflow: hidden !important; display: block !important; }

#install-container-pizza .icon-circle img { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; }

#install-container-pizza .pwa-fallback-btn { display: none; width: 100% !important; background: rgb(26, 26, 26) !important; border-radius: 30px !important; padding: 8px 12px !important; cursor: pointer !important; align-items: center !important; justify-content: center !important; gap: 8px !important; border: 1px solid rgb(51, 51, 51) !important; position: relative !important; z-index: 999 !important; }

#install-container-pizza .fallback-text { color: rgb(255, 0, 0) !important; font-family: sans-serif !important; font-size: 13px !important; font-weight: bold !important; }

#install-container-pizza .fallback-logo { width: 22px !important; height: 22px !important; border-radius: 50% !important; overflow: hidden !important; }

#install-container-pizza .fallback-logo img { width: 100% !important; height: auto !important; }

#install-container-pizza .neon-modal { display: none; position: fixed !important; z-index: 2147483640 !important; left: 0px !important; top: 0px !important; width: 100% !important; height: 100% !important; background-color: rgba(0, 0, 0, 0.9) !important; align-items: center !important; justify-content: center !important; backdrop-filter: blur(8px) !important; }

#install-container-pizza .neon-modal-border { position: relative !important; width: 310px !important; padding: 2px !important; border-radius: 25px !important; background: linear-gradient(90deg, rgb(31, 170, 97), rgb(255, 255, 255), rgb(255, 0, 0)) !important; }

#install-container-pizza .neon-modal-content { position: relative !important; z-index: 2 !important; background: rgb(26, 26, 26) !important; padding: 25px !important; border-radius: 22px !important; text-align: center !important; color: white !important; font-family: sans-serif !important; }

#install-container-pizza .close-btn { position: absolute !important; right: 15px !important; top: 10px !important; font-size: 28px !important; cursor: pointer !important; color: rgb(102, 102, 102) !important; line-height: 1 !important; }

#install-container-pizza .btn-link { display: inline-block !important; background: rgb(79, 172, 254) !important; color: white !important; padding: 10px 20px !important; border-radius: 50px !important; text-decoration: none !important; font-weight: bold !important; margin-top: 10px !important; font-size: 14px !important; }